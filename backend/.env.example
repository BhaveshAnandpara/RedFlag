# Copy to .env for local runs. Real values live only in host settings (Render), never in git.
DATABASE_URL=postgresql://redflag:redflag@localhost:5432/redflag
# Optional. With Neon, set this to the direct (unpooled) URL; migrations prefer it.
# DATABASE_URL_UNPOOLED=
FRONTEND_ORIGIN=http://localhost:3000

# --- Model router (M1) ---
# The password that unlocks the router endpoints and the /router test page. Use a long random
# string. While this is unset, those endpoints are locked for everyone.
# OWNER_TOKEN=
# Provider keys. A provider with no key is simply skipped.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Model names change often. Check each provider's current list before relying on a default.
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENROUTER_FREE_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# Paid models stay off unless BOTH of these are set (a switch and a spending cap above zero).
# ALLOW_PAID_MODELS=false
# PAID_SPEND_CAP_USD=0
# OPENROUTER_PAID_MODEL=
# Saved answers and per-session limits (defaults shown).
# CACHE_TTL_SECONDS=604800
# CACHE_MAX_BYTES=52428800
# BUDGET_MAX_REQUESTS=50
# BUDGET_MAX_TOKENS=100000
# BUDGET_MAX_SECONDS=600
# BUDGET_MAX_CONCURRENCY=2

# The demo bots' own model keys, kept apart from the keys above so the bots' quota and
# Redflag's never compete. Use keys from OTHER accounts or projects: two keys from the same
# account share one limit. Names only here; real values go in .env.local and in Render.
# BOT_GROQ_API_KEY=
# BOT_GEMINI_API_KEY=
# BOT_OPENROUTER_API_KEY=
# BOT_GROQ_MODEL=openai/gpt-oss-20b
# BOT_GEMINI_MODEL=gemini-3.5-flash-lite
# BOT_OPENROUTER_FREE_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# The order the bots' models are tried in (Gemini first, because Groq's gpt-oss rejects the bots' format).
# BOT_PROVIDER_ORDER=gemini,groq,openrouter
# Hard limits for ONE scan (defaults shown), and when a silent scan counts as interrupted.
# BOT_BUDGET_MAX_REQUESTS=150
# BOT_BUDGET_MAX_TOKENS=300000
# BOT_BUDGET_MAX_SECONDS=1800
# BOT_BUDGET_MAX_CONCURRENCY=1
# SCAN_STALE_SECONDS=300
# When every model is rate-limited, a scan waits for the limit to clear (at least WAIT, at most
# MAX seconds) and tries again up to RETRIES times before recording an error that says why.
# SCAN_RATE_LIMIT_WAIT_SECONDS=20
# SCAN_RATE_LIMIT_MAX_WAIT_SECONDS=70
# SCAN_RATE_LIMIT_RETRIES=3
# The AI judge runs on Redflag's own models and keys (the GROQ_/GEMINI_/OPENROUTER_ ones above),
# never the BOT_ keys. Hard limits for the judge in ONE scan (defaults shown).
# JUDGE_BUDGET_MAX_REQUESTS=60
# JUDGE_BUDGET_MAX_TOKENS=200000
# JUDGE_BUDGET_MAX_SECONDS=1800
# Testing your own bot (M6). Limits for one setup: the interviewer, supervisor and generator each
# get this share of Redflag's own model quota. Defaults shown.
# SETUP_BUDGET_MAX_REQUESTS=60
# SETUP_BUDGET_MAX_TOKENS=150000
# SETUP_BUDGET_MAX_SECONDS=3600
# SETUP_CHAT_MAX_MESSAGES=30
# SETUP_MAX_FOLLOWUPS=8
# SETUP_FILE_MAX_BYTES=20000
# SETUP_FILE_MAX_COUNT=5
# The most requests one run may send to the user's own endpoint.
# RUN_MAX_ENDPOINT_REQUESTS=40
# Redflag's own public host name. An endpoint that points at it is refused. Set this on the host.
# PUBLIC_BACKEND_HOST=redflag-8dcv.onrender.com
